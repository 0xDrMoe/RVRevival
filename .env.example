# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from Discord Developer Portal > your application > Bot > Reset Token.
DISCORD_TOKEN=your-bot-token-here

# Application ID from Discord Developer Portal > your application > General Information.
DISCORD_CLIENT_ID=your-application-id-here

# Rumbleverse Revival server ID (Discord: enable Developer Mode, right-click the server icon > Copy Server ID).
# Used by `npm run register` for guild-scoped command registration.
DISCORD_GUILD_ID=your-server-id-here

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Optional: reply in one language for everyone: en, es, de, fr, pt, it or ar.
# Leave empty to reply in each user's Discord language (English if unsupported).
# Discord has no Arabic app language, so set BOT_LANGUAGE=ar to use Arabic.
BOT_LANGUAGE=
