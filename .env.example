# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from Discord Developer Portal > your application > Bot > Reset Token.
DISCORD_TOKEN=your-bot-token-here

# Application ID from Discord Developer Portal > your application > General Information.
DISCORD_CLIENT_ID=your-application-id-here

# Rumbleverse Revival server ID (Discord: enable Developer Mode, right-click the server icon > Copy Server ID).
# Used by `npm run register` for guild-scoped command registration.
DISCORD_GUILD_ID=your-server-id-here

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Optional: reply in one language for everyone: en, es, de, fr, pt, it or ar.
# Leave empty to reply in each user's Discord language (English if unsupported).
# Discord has no Arabic app language, so set BOT_LANGUAGE=ar to use Arabic.
BOT_LANGUAGE=

# --- Web dashboard (npm run dashboard) -------------------------------------
# Only needed on the server that runs the dashboard. See README > Dashboard.

# OAuth2 client secret from Developer Portal > your application > OAuth2 > Reset Secret.
DISCORD_CLIENT_SECRET=

# The dashboard's public address, without a trailing slash. Add
# <this address>/auth/callback under OAuth2 > Redirects in the Developer Portal.
# The bot also uses it for the ban-appeal link in ban DMs.
DASHBOARD_URL=https://rumbleverse.cedartechsolutions.ca

# A long random string that protects logins. Generate one with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# Optional: the local port the dashboard listens on (default 3080). Caddy forwards to it.
DASHBOARD_PORT=3080

# Optional: how people reach you, shown on the /terms and /privacy pages. An
# email address, a web address (like a Discord invite) or plain text.
LEGAL_CONTACT=
