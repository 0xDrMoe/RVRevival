{
  "name": "rabble-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Rabble, the all-in-one Discord bot by Cedar Tech Solutions.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "register": "node --env-file-if-exists=.env src/register-commands.js",
    "dashboard": "node --env-file-if-exists=.env src/dashboard/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fastify/compress": "9.2.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "discord.js": "14.27.0",
    "fastify": "5.12.5",
    "ffmpeg-static": "5.2.0",
    "i18n-iso-countries": "7.14.0",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
